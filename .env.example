# Public (baked into static client bundle). Web3Forms access keys are designed for client forms.
# Never put the internal Gmail address in the repo or site.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Canonical site URL (custom domain when live). Preview hosts (*.pages.dev / *.vercel.app) stay noindex.
# NEXT_PUBLIC_SITE_URL=https://example.com
